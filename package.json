{
  "name": "permio",
  "version": "0.1.0",
  "description": "TypeScript SDK for the perms.io permissions API",
  "license": "MIT",
  "author": "PrivateJAR",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrivateJAR/permio-js.git"
  },
  "homepage": "https://perms.io",
  "keywords": ["permio", "perms.io", "permissions", "rbac", "authorization", "grpc-web", "connect"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "generate": "scripts/generate.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
